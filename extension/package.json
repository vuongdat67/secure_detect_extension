{
  "name": "securecopilot",
  "displayName": "SecureCopilot",
  "description": "AI code review tập trung security cho C/C++/Python (POC).",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters"],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "securecopilot.analyzeSelection",
        "title": "SecureCopilot: Analyze Selection",
        "category": "SecureCopilot"
      },
      {
        "command": "securecopilot.analyzeFile",
        "title": "SecureCopilot: Analyze Current File",
        "category": "SecureCopilot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "securecopilot.analyzeSelection",
          "group": "navigation@100"
        },
        {
          "command": "securecopilot.analyzeFile",
          "group": "navigation@101"
        }
      ],
      "editor/title": [
        {
          "command": "securecopilot.analyzeFile",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "SecureCopilot",
      "properties": {
        "securecopilot.apiBase": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Base URL của SecureCopilot API (vd: http://localhost:8000)",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "echo 'no lint configured'"
  },
  "devDependencies": {
    "@types/node": "^22.9.4",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {}
}
